{
  "name": "pi-paster",
  "version": "0.1.4",
  "description": "Pi extension that turns pasted image paths into first-class image attachments.",
  "keywords": [
    "image-attachments",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/silouanwright/pi-paster#readme",
  "bugs": {
    "url": "https://github.com/silouanwright/pi-paster/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silouanwright/pi-paster.git"
  },
  "files": [
    "src",
    "docs",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "packageManager": "pnpm@10.34.5",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://unpkg.com/pi-paster@0.1.4/docs/preview.png"
  }
}
